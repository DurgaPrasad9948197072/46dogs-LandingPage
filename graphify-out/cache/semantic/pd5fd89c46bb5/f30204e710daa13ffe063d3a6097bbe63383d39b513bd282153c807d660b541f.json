{"nodes": [{"id": "public_logo", "label": "46DOGS Master Logo (logo.png)", "file_type": "image", "source_file": "public/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "2048x2048 square master brand logo: white artwork on solid black. Stacked layout with a seated-dog mark above the 46DOGS wordmark and the tagline 'RESCUE. CARE. LOVE.'", "rationale": "Monochrome, high-contrast square master gives one source that a script can crop and recolor into favicon, app icon, OG card, mark and lockup variants. The large empty black margin leaves room to crop."}, {"id": "public_logo_dog_numeral_mark", "label": "Dog-from-46 Numeral Mark", "file_type": "concept", "source_file": "public/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Seated dog in right-facing profile (floppy ear, eye, whisker dots). Its body is drawn from the digits '4' and '6': the 4 forms the haunch and the 6 forms the chest and front leg, and a curved white tail sweeps around the left side.", "rationale": "Merges the brand number into the dog so the symbol works alone at small sizes such as icons, and the name and image read as one."}, {"id": "public_logo_wordmark", "label": "46DOGS Wordmark", "file_type": "concept", "source_file": "public/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Wide-tracked geometric sans-serif capitals reading '46DOGS', set below the mark."}, {"id": "public_logo_tagline", "label": "Tagline: Rescue. Care. Love.", "file_type": "concept", "source_file": "public/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Small, widely spaced capitals 'RESCUE. CARE. LOVE.' that place the brand as a dog rescue and care organization."}], "edges": [{"source": "public_logo", "target":